# ===== App =====
APP_NAME=Chat3D
# your public https URL in production
APP_URL=http://localhost:8000
# set to production when live
ENVIRONMENT=development
# required in production: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# these accounts get the admin dashboard
ADMIN_EMAILS=you@example.com

# ===== Business details (legal pages, receipts) =====
COMPANY_NAME=MeeraAI Tech Solutions LLP
COMPANY_ADDRESS=2nd Floor, A Wing 202, Rizvi Palace, Hill Road, Bandra (West), Mumbai 400050, India
SUPPORT_EMAIL=team@meeraaitech.com

# ===== Database =====
# SQLite works for one server; use Postgres in production.
# DATABASE_URL=postgresql+psycopg://chat3d:password@db:5432/chat3d

# ===== Storage =====
# local | s3
STORAGE_BACKEND=local
# S3_BUCKET=your-bucket
# S3_REGION=ap-south-1

# ===== Generation providers =====
# fal.ai key from fal.ai/dashboard/keys. Use "mock" for all three to develop offline at no cost.
FAL_KEY=
# fal | mock
IMAGE_PROVIDER=fal
# fal (BiRefNet, MIT) | none | mock
BG_PROVIDER=fal
# fal (TRELLIS.2) | mock | hf_space (dev only, non-commercial)
MESH_PROVIDER=fal

# ===== Credits =====
SIGNUP_CREDITS=12
COST_IMAGE=1
COST_MODEL_512=8
COST_MODEL_1024=10
COST_MODEL_1536=12
# Packs in paise / cents. Default: 50 for ₹499/$6.99, 200 for ₹1,699/$23.99, 600 for ₹4,499/$63.99
# CREDIT_PACKS=[{"id":"starter","name":"Starter","credits":50,"inr":49900,"usd":699}]

# ===== Payments =====
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# webhook URL: {APP_URL}/webhooks/razorpay  (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
# webhook URL: {APP_URL}/webhooks/stripe   (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# ===== Email (receipts, password reset) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Chat3D <team@meeraaitech.com>
